<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Inicio de Sesión </title>
    <link rel="stylesheet" href="/css/Login_Style.css">
</head>
<body>
    <form action="/iniciar_sesion" method="POST">
        <div class="container-main">
            
                <div class="login_container">

                    <div id="imgContainer">
                        <img src="/img/area.jpg" alt="imagen de el area de ingenieria en sistemas">
                    </div>
                    <div class="login-header">
                        <h2>Iniciar sesión</h2>
                        <p>Ingrese sus datos para acceder</p>
                    </div>
                    
                    <div class="input-group">
                        <label for="email">Correo Electrónico</label>
                        <input type="email" id="email" name="email" placeholder="Ingrese su correo" required>
                    </div>

                    <div class="input-group">
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" placeholder="Ingrese su contraseña" required>
                    </div>

                    <button type="submit"id="submit">Iniciar Sesión</button>

                    <div id="divAlerta">
                        <% if (locals.error){%>
                            
                            <p id="textoAlerta"><%=error%></p>
                        <%}else{%>
                            <p id="textoAlerta">Una alerta</p>
                        <%}%>
                    </div>

                    <a href="/registrar">¿No tienes cuenta? Crea una</a>
                </div>
            
        </div>
    </form>

    <script>
        // verificamos si existe un error para traerlo.
        const contenedorAlerta = document.getElementById("divAlerta");
        const error = "<%=locals.error%>";

        if (error){ // si existe un error, agregamos la clase de mostrar al div
            contenedorAlerta.classList.add("mostrar");
        }


    </script>
</body>
</html>