<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/impresion.css">
    <title>Inscripciones</title>
</head>
<body>


    <div id="contenedor">
        <div id="header">
            <img src="/img/unerg.png" alt="">
            <div id="header-info">
                <h5>Republica Bolivariana de Venezuela</h5>
                <h5>Universidad Nacional Experimental Romulo Gallegos</h5>
                <h5>Direccion y control de preinscripciones</h5>
            </div>
        </div>
   
        <div id="container-info">
        <h3>Preinscriciones</h3>
        <p>Periodo: <%=periodo%></p>
        <p>Carrera: : (601) INGENIERIA EN INFORMATICA - INGENIERIA DE SISTEMAS (SAN JUAN DE
LOS MORROS)</p>

        </div>


        <table id="tabla">
            <thead>
                <tr>
                    <th class="celda-corta">Cod Materia</th>
                    <th class="celda-larga">Nombre Materia</th>
                    <th class="celda-corta">Preinscripciones</th>
                </tr>

            </thead>

            <tbody>
                <% inscripciones.forEach((materia)=>{%>
                <tr>
                    <td><%=materia.codigo%></td>
                    <td><%=materia.nombre%></td>
                    <td><%=materia.cantidad%></td>
                </tr>
                <% }); %>

            </tbody>
            

        </table>
     </div>
    
     <script>

        window.addEventListener("DOMContentLoaded",()=>{
            // Imprimimos el documento.
            window.print();

        });

     </script>




    
</body>
</html>