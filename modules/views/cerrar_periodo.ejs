<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cerrar periodo</title>
</head>
<body>
    
    <form action="/admin/cerrar_periodo" method="post">
        <div id="modal-delete-container">
            <div id="modal-delete">
                <div id="info">
                    <h3 id="message-red">Esta seguro que desea cerrar el siguiente intensivo?</h3>
                    <h3 id="normal-text"><%=periodo.nombre%></h3>
                </div>

                <div id="disclaimer-content">
                    <h3 id="disclaimer-title">Alerta</h3>
                    <p>Luego de ser cerrado, quedara finalizado y no podran inscribirse.</p>
                </div>
                
                <div id="modal-buttons">
                    <button type="submit" id="eliminar-periodo">Eliminar</button>
                    <a href="/admin/dashboard" id="regresar">Regresar</a>
                </div>
            </div>
        </div>
    </form>
    
</body>
</html>